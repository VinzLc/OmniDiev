node_modules/
.next/
*.tsbuildinfo
next-env.d.ts
.DS_Store

# ── Secrets ────────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Sorties régénérables ───────────────────────────────────────────────────
# `npm run ingest` les reconstruit depuis les PDF ; `npm run codex` le Codex.
data/

# ── Sources ────────────────────────────────────────────────────────────────
# Les romans d'Anne Robillard sont des œuvres sous droits : ils restent en
# local. Le motif couvre toutes les épopées, présentes et à venir — n'en
# nommer qu'une laissait passer les suivantes.
Epop*/

# Dossier temporaire du build statique (scripts/build-site.ts).
.api.parked/
out/

# ── Godot ──────────────────────────────────────────────────────────────────
# Cache d'import, reconstruit au premier lancement par `npm run jeu`.
.godot/
# Planches copiées depuis jeu/art/ ; elles y sont déjà versionnées.
jeu/godot/assets/
# Images du mode --capture, qui ne servent qu'à vérifier une scène.
jeu/godot/capture*.png
# Et les fichiers d'import que Godot leur fabrique : ignorer l'image en laissant
# passer son sillage n'ignore rien du tout.
jeu/godot/capture*.png.import

# Vignette d'amorce que `art:generer` retaille depuis la planche à chaque appel.
# Une copie versionnée ne serait jamais relue : elle est réécrite avant usage.
jeu/art/portraits/.*.cellule.png

# Réglages personnels de Claude Code : la publication automatique vise le dépôt
# de Vinz, elle n'a pas à s'imposer à qui clone.
.claude/settings.local.json
