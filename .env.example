# ── Authentification ───────────────────────────────────────────────────────
# Deux voies possibles ; le code construit un client nu et prend la première
# disponible. Inutile de renseigner les deux.
#
#   1. Une clé API — https://console.anthropic.com/settings/keys
#   2. Un profil OAuth, sans clé à gérer :
#        brew install anthropics/tap/ant
#        ant auth login
#      Laissez alors ANTHROPIC_API_KEY commentée : une clé définie, même vide,
#      masque le profil.

ANTHROPIC_API_KEY=sk-ant-...

# ── Modèles ────────────────────────────────────────────────────────────────
# Modèle de conversation (défaut : claude-opus-5)
# OMNIDIEV_MODEL=claude-opus-5

# Modèle utilisé par `npm run codex` (défaut : claude-haiku-4-5)
# OMNIDIEV_CODEX_MODEL=claude-haiku-4-5

# Profondeur de raisonnement : low | medium | high | xhigh | max
# OMNIDIEV_EFFORT=medium
