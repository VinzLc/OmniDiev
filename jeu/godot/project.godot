; Projet Godot — Les Chevaliers d'Émeraude
;
; La scène n'est pas décrite ici mais construite dans main.gd. Un .tscn écrit à
; la main dépend d'identifiants de ressources générés par l'éditeur ; le code,
; lui, se relit et se corrige.

config_version=5

[application]

config/name="Les Chevaliers d'Émeraude"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]

; 640×360 : vingt tuiles de large sur onze, en 16/9.
;
; C'est le viewport qu'on agrandit, non le zoom de la caméra. Une caméra à 1,75
; ferait rendre un sprite de 32 pixels sur 56 : les pixels cesseraient d'être
; carrés, ce qui est précisément ce qu'on cherche à préserver. Le zoom reste
; donc à 2, entier, et c'est la toile qui gagne du champ.
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1600
window/size/window_height_override=900
window/size/resizable=true
window/stretch/mode="viewport"

; Sur un écran Retina, rendre à la définition physique plutôt qu'aux points :
; l'agrandissement de 2,5 y devient beaucoup moins visible.
window/dpi/allow_hidpi=true

[rendering]

; Sans cela, Godot lisse les textures à l'agrandissement et le pixel art fond.
textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
